# Copia este archivo a ".env" (mismo folder) y rellena los valores reales.
# El ".env" real NUNCA se sube a Git — este archivo de ejemplo sí, para que
# cualquiera sepa qué variables necesita configurar sin adivinar leyendo el código.

# URL del backend. En local no hace falta (vite.config.js ya redirige
# /api a http://localhost:4000). En producción: la URL real del backend.
VITE_API_URL=

# --- Login con Google ---
# Mismo Client ID que GOOGLE_CLIENT_ID en backend/.env — ver ese archivo
# para cómo generarlo. Si se deja vacío, el botón "Continuar con Google"
# simplemente no aparece (el registro/login con correo sigue funcionando
# normal).
VITE_GOOGLE_CLIENT_ID=

# --- Botón "Hotel" (servicios comerciales del partido) ---
# ID de afiliado del programa de Booking.com (u otro proveedor de hoteles).
# Se agrega al link de búsqueda de hotel para que las reservas generadas
# desde LIFA App se le atribuyan a CFBAMX. Mientras este trámite
# administrativo no esté listo, se puede dejar VACÍO: el botón Hotel
# funciona igual (sin comisión) y no requiere ningún cambio de código el
# día que se llene — ver frontend/src/utils/matchServices.js.
VITE_HOTEL_AFFILIATE_ID=
