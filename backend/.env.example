# Copia este archivo a ".env" (mismo folder) y rellena los valores reales.
# El ".env" real NUNCA se sube a Git (está en .gitignore) — este archivo de
# ejemplo sí se sube, para que cualquiera sepa qué variables necesita
# configurar sin tener que adivinar leyendo el código.

# --- Base de datos (Postgres en Neon: https://neon.tech) ---
DATABASE_URL=postgresql://usuario:password@host/basededatos?sslmode=require

# Puerto local del backend (Render define el suyo propio automáticamente en producción)
PORT=4000

# --- Seguridad ---
# Cadena aleatoria y larga. Generar una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Usa una DISTINTA en cada ambiente (local, producción) — nunca reutilices la misma.
JWT_SECRET=

# Dominios desde donde el navegador puede llamar a esta API, separados por coma.
# En local no hace falta (localhost:5173 ya está permitido siempre).
# En producción: tu dominio real, ej. https://tu-app.vercel.app
ALLOWED_ORIGINS=

# --- Cloudinary (imágenes: logos, fotos de equipo, etc.) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Notificaciones push (Web Push / VAPID) ---
# Generar el par de llaves con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# --- Cronjob externo ---
# Secreto compartido que el cronjob manda en el header al llamar
# POST /api/notifications/trigger. Cualquier cadena larga sirve.
CRON_SECRET=
