# Copia este archivo a ".env" (mismo folder) y rellena los valores reales.
# El ".env" real NUNCA se sube a Git (está en .gitignore) — este archivo de
# ejemplo sí se sube, para que cualquiera sepa qué variables necesita
# configurar sin tener que adivinar leyendo el código.

# --- Base de datos (Postgres en Neon: https://neon.tech) ---
DATABASE_URL=postgresql://usuario:password@host/basededatos?sslmode=require

# Puerto local del backend (Render define el suyo propio automáticamente en producción)
PORT=4000

# --- Seguridad ---
# Cadena aleatoria y larga. Generar una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Usa una DISTINTA en cada ambiente (local, producción) — nunca reutilices la misma.
JWT_SECRET=

# Dominios desde donde el navegador puede llamar a esta API, separados por coma.
# En local no hace falta (localhost:5173 ya está permitido siempre).
# En producción: tu dominio real, ej. https://tu-app.vercel.app
ALLOWED_ORIGINS=

# --- Cloudinary (imágenes: logos, fotos de equipo, etc.) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Notificaciones push (Web Push / VAPID) ---
# Generar el par de llaves con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# --- Verificación de correo (código de 6 dígitos al registrarse) ---
# API key de Resend (https://resend.com/api-keys). Plan gratis alcanza de sobra.
RESEND_API_KEY=
# Remitente que verás en la bandeja del usuario, ej: "LIFA App <no-reply@tudominio.com>"
# El dominio debe estar verificado en Resend (o usa el de prueba onboarding@resend.dev
# mientras configuras tu propio dominio).
EMAIL_FROM=

# --- Login con Google ---
# Client ID de OAuth (tipo "Web application") desde Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Agrega tu dominio (y http://localhost:5173 para desarrollo) en
# "Authorized JavaScript origins". No hace falta Client Secret: el flujo
# usado (Google Identity Services, botón "Continuar con Google") solo
# necesita el Client ID, tanto aquí como en frontend/.env (VITE_GOOGLE_CLIENT_ID,
# debe ser el MISMO valor en ambos lados).
GOOGLE_CLIENT_ID=

# --- Cronjob externo ---
# Secreto compartido que el cronjob manda en el header al llamar
# POST /api/notifications/trigger. Cualquier cadena larga sirve.
CRON_SECRET=

# --- Bot de WhatsApp con IA (tiendas con plan 'pro') ---
# Token de acceso de la WhatsApp Business Platform (Meta for Developers >
# tu App > WhatsApp > Primeros pasos). El temporal dura 24h; para
# producción genera uno permanente (System User) una vez verificado el
# negocio.
WHATSAPP_ACCESS_TOKEN=
# Cadena que TÚ inventas (ej. generada con `openssl rand -hex 16`) y que
# pegas también en el panel de Meta al configurar la URL del webhook —
# es como Meta confirma que el webhook es tuyo.
WHATSAPP_VERIFY_TOKEN=
# Versión de la Graph API de Meta. No cambiar salvo que Meta la deprecie.
WHATSAPP_API_VERSION=v21.0
# API key de Anthropic (console.anthropic.com) — la usa el backend para
# generar las respuestas del bot. Nunca se expone al frontend.
ANTHROPIC_API_KEY=